{
  "name": "mcp-legislation",
  "version": "0.2.0",
  "private": true,
  "description": "Texte officiel en lecture seule de lois et règlements du Québec et du Canada (en français et en anglais), hiérarchie complète des divisions et recherche hybride lexicale et sémantique.",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "dev": "wrangler dev --var MCP_TOKEN:local-a --var MCP_TOKEN_VEILLE:local-b",
    "start": "wrangler dev --var MCP_TOKEN:local-a --var MCP_TOKEN_VEILLE:local-b",
    "deploy": "node scripts/deployer.mjs",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "db:schema:local": "wrangler d1 execute legislation --local --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply legislation --local",
    "db:migrate:remote": "wrangler d1 migrations apply legislation --remote",
    "evals": "node tests/evals.mjs",
    "eval": "node eval/run.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "node scripts/wrangler-test-config.mjs --ecrire"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "agents": "^0.33.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@poirierlavoie/socle-juridique": "github:jpoirierlavoie/MCP-Socle-Juridique#v0.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.8",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "zod": "$zod"
  }
}
