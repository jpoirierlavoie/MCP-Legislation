{
  "name": "mcp-legislation",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur MCP « Lois du Québec » — Worker Cloudflare (lecture seule sur D1).",
  "scripts": {
    "dev": "wrangler dev --var MCP_TOKEN:local-a --var MCP_TOKEN_VEILLE:local-b",
    "start": "wrangler dev --var MCP_TOKEN:local-a --var MCP_TOKEN_VEILLE:local-b",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "db:schema:local": "wrangler d1 execute legislation --local --file=./schema.sql",
    "evals": "node tests/evals.mjs",
    "eval": "node eval/run.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "node scripts/wrangler-test-config.mjs --ecrire"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@poirierlavoie/socle-juridique": "github:jpoirierlavoie/MCP-Socle-Juridique#v0.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.112.0"
  }
}
