{
  "name": "mcp-legislation",
  "version": "2.0.0",
  "private": true,
  "description": "Texte officiel en lecture seule de lois, règlements, directives de pratique et orientations AMF du Québec et du Canada (français et anglais, certains PDF en français seulement), hiérarchie complète des divisions et recherche hybride lexicale et sémantique.",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "dev": "wrangler dev --var MCP_TOKEN:local-a --var MCP_TOKEN_VEILLE:local-b",
    "start": "wrangler dev --var MCP_TOKEN:local-a --var MCP_TOKEN_VEILLE:local-b",
    "deploy": "node scripts/deployer.mjs",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "db:schema:local": "wrangler d1 execute legislation --local --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply legislation --local",
    "db:migrate:remote": "wrangler d1 migrations apply legislation --remote",
    "evals": "node tests/evals.mjs",
    "eval": "node eval/run.mjs",
    "eval:gate": "node eval/run.mjs --gate",
    "backfill:incremental": "node scripts/backfill-vectors.mjs --mode incremental --prune",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit": "node scripts/verifier-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "node scripts/wrangler-test-config.mjs --ecrire"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@poirierlavoie/mcp-socle": "github:jpoirierlavoie/MCP-Socle#v0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  }
}
