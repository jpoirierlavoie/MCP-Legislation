{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legislation",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Domaine personnalisé (zone poirierlavoie.ca) : Cloudflare gère DNS + certificat.
  "routes": [{ "pattern": "legislation.poirierlavoie.ca", "custom_domain": true }],
  // workers.dev fermé hors rattrapage (surface minimale). Pour un futur backfill
  // (rafraîchissement semestriel), le réactiver temporairement : le WAF de la zone
  // bloque les rafales de POST du pilote sur le domaine personnalisé.
  "workers_dev": false,

  // McpAgent est un Durable Object : le binding + la migration new_sqlite_classes
  // sont obligatoires. Le nom de classe doit être identique à l'export de src/index.ts.
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "QclawMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QclawMCP"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "legislation",
      // Base D1 réelle (compte « Jason Poirier Lavoie », région ENAM), créée via
      // `wrangler d1 create legislation`. Le dev local utilise quand même un SQLite local.
      "database_id": "82779d59-480f-4847-9716-6f4d7c62af5b"
    }
  ],

  // Chemins de récupération réversibles (plan v2, R8) : rollback = flip de variable.
  // RELAX_SEARCH : échelle de relaxation de legislation_search_text (1.2). "0" pour désactiver.
  // HYBRID_SEARCH : recherche hybride FTS + vecteurs (2.3). "0" tant que le rattrapage
  // des vecteurs n'est pas validé ; bascule à "1" ensuite (séquence de déploiement §2).
  // FEDERAL_CORPUS : l'interrupteur du corpus fédéral (R8). À "0", les textes
  // `jurisdiction = 'ca'` sont INVISIBLES à tous les outils, même chargés en base. On peut
  // donc ingérer les 18 textes, les vérifier et mesurer le repérage EN PRODUCTION sans rien
  // servir, puis ouvrir d'un flip — et refermer de même si la qualité se dégrade. Fermé par
  // défaut à dessein : un déploiement qui oublierait la variable ne sert rien de neuf, au
  // lieu de tout servir d'un coup.
  // MCP_ENABLED — COUPE-CIRCUIT DU BLOC /mcp, fermé par défaut.
  //
  // La polarité est « !== "true" ⇒ éteint » : variable absente, vide ou mal orthographiée
  // coupe le service. Ne JAMAIS l'écrire « === "false" », ce serait un garde ouvert par
  // défaut sur un point d'entrée destiné au multilocataire.
  //
  // ⚠ SA PRÉSENCE ICI EST OBLIGATOIRE, et son oubli aurait éteint la production au premier
  //   déploiement — constaté avant, pas après. Le coupe-circuit ne touche ni « / », ni les
  //   documents publics : c'est quand le connecteur est coupé qu'un confrère doit pouvoir
  //   lire pourquoi.
  //
  // SOCLE — bascule du transport. Absent ou différent de "true" : McpAgent sert, comme
  // depuis toujours. À "true" : le routeur bâti sur @poirierlavoie/socle-juridique prend le
  // relais, chaîne intergicielle et authentification comprises. Le drapeau bascule le chemin
  // ENTIER, pour qu'on observe un comportement et non un mélange. Reste fermé jusqu'à ce
  // que la bascule soit faite délibérément, l'URL du connecteur posée AVANT.
  "vars": {
    "RELAX_SEARCH": "1",
    "HYBRID_SEARCH": "1",
    "FEDERAL_CORPUS": "1",
    "MCP_ENABLED": "true",
    "SOCLE": "true"
  },

  // Limitation de débit DANS le Worker, et non au WAF de la zone — même choix que le
  // connecteur jumeau (jurisprudence), qui a constaté que la limitation de zone n'était pas
  // accessible malgré l'abonnement Pro. Bénéfice second, décisif ici : une règle WAF vit au
  // tableau de bord, hors du dépôt et hors CI ; ce binding est VERSIONNÉ et se relit.
  //
  // LE SEUIL EST MESURÉ, PAS RECOPIÉ. Le jumeau tient à 60/min parce que ses clients sont
  // des humains. Ici, `npm run evals` a émis 61 requêtes en 3 s (mesuré le 2026-08-27 sur
  // wrangler dev) et `npm run eval` en émet une soixantaine : à 60/min, les DEUX harnais
  // déclencheraient leurs propres 429 et on lirait une régression là où il n'y a qu'un
  // compteur. 300/min laisse 5x la rafale mesurée et coupe toujours un flot abusif.
  // Le clavardage de Pallas Athéna, lui, est structurellement borné (2 instances App
  // Engine, 2 dépêches concurrentes) : il n'approche pas ce seuil.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],

  // Couche sémantique (plan v2, phase 2) : embeddings bge-m3 + index Vectorize.
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORS", "index_name": "legislation-articles" }],

  // DÉCLENCHEUR INERTE : aucun handler `scheduled` n'existe dans src/ — ce cron ne
  // lance RIEN. Le rafraîchissement semestriel est VOLONTAIREMENT manuel et supervisé
  // (cf. CLAUDE.md) : l'ancien workflow automatique a été retiré parce qu'il rechargeait
  // les articles sans les vecteurs, laissant du droit périmé rendu en silence.
  // NE PAS retirer ce bloc pour « faire le ménage » : sans clé `crons`, wrangler n'émet
  // aucun PUT /schedules, donc le horaire resterait ARMÉ chez Cloudflare et déclaré
  // nulle part. Pour désarmer : déployer `"crons": []` d'abord, vérifier, puis retirer.
  "triggers": { "crons": ["0 9 5 1,7 *"] }
}
